{
  "name": "@easydeck/core",
  "version": "0.1.0",
  "description": "Core zone: wires device + engine + renderer together, persists profiles and settings, owns the actions that touch the machine, and serves the API. Runs inside the desktop app's main process or headless",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist/**/*.test.js\"",
    "start": "tsc -p tsconfig.json && node dist/examples/run-headless.js",
    "keyboard-check": "tsc -p tsconfig.json && node dist/examples/keyboard-check.js",
    "api-client": "tsc -p tsconfig.json && node dist/examples/api-client.js"
  },
  "dependencies": {
    "@easydeck/compositor": "workspace:*",
    "@easydeck/device": "workspace:*",
    "@easydeck/engine": "workspace:*",
    "@easydeck/renderer": "workspace:*",
    "@easydeck/ui": "workspace:*",
    "koffi": "^3.1.2",
    "ws": "^8.21.1"
  },
  "optionalDependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3"
  }
}
