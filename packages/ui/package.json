{
  "name": "@easydeck/ui",
  "version": "0.1.0",
  "description": "UI zone: the Vue configurator. Runs in the desktop app window over IPC, or in a browser over the WebSocket API — the transport is the only thing that differs",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@easydeck/engine": "workspace:*",
    "dejavu-fonts-ttf": "^2.37.3",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8"
  },
  "devDependencies": {
    "@easydeck/core": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.8",
    "@types/node": "^24.13.3",
    "typescript": "~5.9.3",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.8"
  }
}
