{
  "name": "@easydeck/plugin-sdk",
  "version": "0.1.0",
  "description": "Plugin SDK zone: types and helpers for out-of-process plugins that add actions, events and variables over the daemon's WebSocket API",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~5.9.3"
  }
}
