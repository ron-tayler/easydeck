{
  "name": "@easydeck/daemon",
  "version": "0.1.0",
  "description": "Daemon zone: the headless background service that wires device + engine + renderer together, persists configuration and exposes the WebSocket API for UIs",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~5.9.3"
  }
}
